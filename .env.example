# Opporbyte Environment Configuration Template
# Duplicate this file as .env and populate with your secure local values.

# -----------------------------------------------------------------------------
# General Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME="Opporbyte"
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For Docker / Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://opporbyte:opporbyte_secret@localhost:5432/opporbyte
# For local development without Docker, SQLite can be used:
DATABASE_URL=sqlite:///./opporbyte.db

# PostgreSQL Docker credentials (used by docker-compose.yml)
POSTGRES_USER=opporbyte
POSTGRES_PASSWORD=opporbyte_secret
POSTGRES_DB=opporbyte
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Security & Single-User Authentication
# -----------------------------------------------------------------------------
# Generate a secure 32+ byte key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_super_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Single-User Setup Credentials
# Used by `python -m app.core.init_db` to bootstrap the initial single-user account safely.
FIRST_USER_EMAIL=engineer@opporbyte.internal
FIRST_USER_PASSWORD=ChangeMe123!SecurePassword

# Session & Cookie Security
COOKIE_SECURE=false # Set to true in production with HTTPS
COOKIE_SAMESITE=lax
COOKIE_NAME=opporbyte_session

# -----------------------------------------------------------------------------
# CORS & Networking
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Future Integrations (Phase 2 & Phase 3 placeholders)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# OPENAI_API_KEY=
# GEMINI_API_KEY=
